{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "_comment": "Production parameter file for deployments backed by an Azure Key Vault. After bootstrapping a KV, replace the __PLACEHOLDERS__ and rename this file to parameters.json. For first-time deploys, parameters.json passes secrets inline via deploy.sh --parameters and dbAdminPassword/jwtSecretKey are not declared here.",
  "parameters": {
    "appName": {
      "value": "cortex"
    },
    "location": {
      "value": "westus2"
    },
    "openaiLocation": {
      "value": "westus"
    },
    "containerImageTag": {
      "value": "latest"
    },
    "frontendOrigin": {
      "value": "https://cortex-app.azurestaticapps.net"
    },
    "dbAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/__SUBSCRIPTION_ID__/resourceGroups/__KV_RESOURCE_GROUP__/providers/Microsoft.KeyVault/vaults/__KEY_VAULT_NAME__"
        },
        "secretName": "cortex-db-admin-password"
      }
    },
    "jwtSecretKey": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/__SUBSCRIPTION_ID__/resourceGroups/__KV_RESOURCE_GROUP__/providers/Microsoft.KeyVault/vaults/__KEY_VAULT_NAME__"
        },
        "secretName": "cortex-jwt-secret-key"
      }
    }
  }
}
